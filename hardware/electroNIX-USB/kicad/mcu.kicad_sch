  (text "ESP32 module (GPIO map = firmware BOARD_ELECTRONIX_3, except MEL/RTC)"
    (at 21.27 26.27 0)
    (effects
      (font
        (size 2 2) bold)
      (justify left top))
    (uuid "1e4c5dbd-f5d1-50ee-969c-00df050d8a3e"))
  (text "Strapping pins at reset:\n IO0  high = run   (4k7 SCL pull-up; BOOT / auto-reset pull it low)\n IO2  low/float    (boost gate pull-down on HV sheet)\n IO12 low = 3.3 V flash  (100k pull-down on MEL)\n IO15 high         (4k7 SDA pull-up)\n IO5  SEC_1 neon driver base - default state is harmless"
    (at 25 160 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left top))
    (uuid "6a5319f4-6c42-5a34-b490-7a62be335acf"))
