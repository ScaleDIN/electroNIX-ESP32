      (type none))
    (uuid "d4291067-c800-58e0-8d26-e7f18024ecce"))
  (text "Peripherals"
    (at 216.27 106.27 0)
    (effects
      (font
        (size 2 2) bold)
      (justify left top))
    (uuid "044345fb-5448-59c9-bc73-36ba3a3be5ad"))
  (text "No buzzer and no RTC: time comes from NTP (firmware BOARD_HAS_RTC 0).\nIO0 has a 10k pull-up so it boots normally."
    (at 222 178 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left top))
    (uuid "3d0a1b8b-5de6-5d1f-87d1-bdc37bacbd7e"))
