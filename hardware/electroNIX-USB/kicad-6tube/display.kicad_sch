  (text "Anode switches (one per tube, MMBTA42 level shift + MMBTA92 high side)"
    (at 21.27 26.27 0)
    (effects
      (font
        (size 2 2) bold)
      (justify left top))
    (uuid "5fbf3bfc-8af3-5fd3-9b38-6f0c6d0e7c4b"))
  (text "W_n high -> tube n anode at +170V through 10k. Anode current ~2 mA peak.  W_5/W_6 = IO12/IO15 (seconds tubes)."
    (at 25 98 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left top))
    (uuid "eee54c8e-a1bf-53c8-86e8-0a7fd9a07b33"))
  (rectangle
    (start 20 115)
    (end 400 210)
    (stroke
      (width 0.15)
      (type dash))
    (fill
      (type none))
    (uuid "fadc25ef-5ab7-5808-baa3-b82e34a2a1c5"))
  (text "Tubes (RFT Z573M, B13D base, pin 7 at front)"
    (at 21.27 116.27 0)
    (effects
      (font
        (size 2 2) bold)
      (justify left top))
    (uuid "39a85589-92a8-5e78-a6ef-b309bd730dd2"))
  (text "Pin 4 = internal connection (leave open). Pin 10 = PR sign (unused).\nPinout from tube-tester.com Z573M page; check against a real tube before layout."
    (at 25 195 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left top))
    (uuid "f31ed8c6-5769-5fa3-974d-22077d3c73b8"))
  (rectangle
    (start 20 220)
    (end 400 300)
    (stroke
